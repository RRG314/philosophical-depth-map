# Public configuration only. NEVER place a secret in any VITE_ variable.
VITE_BASE_PATH=/
# Optional separately deployed Worker origin, without trailing slash:
# VITE_AI_ENDPOINT=https://your-worker.workers.dev

# Community: public Firebase web configuration (not admin credentials)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_APP_ID=
# Local development only; production builds never connect to emulators.
VITE_FIREBASE_EMULATORS=false
